# Copier ce fichier en .env et adapter les valeurs pour l'environnement local.

DEBUG=True
SECRET_KEY=change-me-en-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de donnees PostgreSQL
DATABASE_URL=postgres://kogl_user:kogl_password@localhost:5432/kogl_taaba

# Origines autorisees pour le frontend React/PWA (separees par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Duree de vie des tokens JWT (en minutes / jours)
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7
